NODE_ENV=development
PORT=3000
# Neon connection string — use the pooled ("-pooler") host from the Neon
# console unless a feature needs session-pinned features (LISTEN/NOTIFY,
# advisory locks). Must include sslmode=require.
# postgresql://<user>:<password>@<host>-pooler.<region>.aws.neon.tech/<db>?sslmode=require
DATABASE_URL=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=