NODE_ENV=development
PORT=3000
# Neon connection string — use the pooled ("-pooler") host from the Neon
# console unless a feature needs session-pinned features (LISTEN/NOTIFY,
# advisory locks). Must include sslmode=require.
# postgresql://<user>:<password>@<host>-pooler.<region>.aws.neon.tech/<db>?sslmode=require
DATABASE_URL=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
# See docs/app/features/court-booking-flow.md for the one-time setup that
# produces these three values (create the flow, generate the RSA keypair,
# set the business public key, publish).
WHATSAPP_FLOW_ID=
# PEM private key with real newlines replaced by literal \n, e.g.:
# WHATSAPP_FLOW_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvQ...\n-----END PRIVATE KEY-----\n"
WHATSAPP_FLOW_PRIVATE_KEY=
# Only needed if the private key was generated with -aes256 (a passphrase).
WHATSAPP_FLOW_PRIVATE_KEY_PASSPHRASE=
# "draft" while testing an unpublished flow (only deliverable to numbers
# registered as testers in the App Dashboard); "published" once Meta's
# publish/integrity check passes. Defaults to "published" if unset.
WHATSAPP_FLOW_MODE=draft
# Origin of the admin dashboard (packages/web), allowed via CORS.
CLIENT_URL=http://localhost:5173