{
  "version": "5.1",
  "data_api_version": "3.0",
  "routing_model": {
    "DATE_SELECT": ["SLOT_SELECT"],
    "SLOT_SELECT": ["FIELD_SELECT"],
    "FIELD_SELECT": ["CONFIRM"],
    "CONFIRM": []
  },
  "screens": [
    {
      "id": "DATE_SELECT",
      "title": "Alege ziua",
      "data": {
        "dates": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "title": { "type": "string" }
            }
          },
          "__example__": [
            { "id": "2026-08-11", "title": "Marți, 11 08" },
            { "id": "2026-08-12", "title": "Miercuri, 12 08" }
          ]
        },
        "week_offset": { "type": "number", "__example__": 0 }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          { "type": "TextHeading", "text": "Rezervare Teren Tenis Tineretului" },
          { "type": "TextBody", "text": "Alege ziua în care vrei să joci." },
          {
            "type": "RadioButtonsGroup",
            "name": "date_id",
            "label": "Zi disponibilă",
            "data-source": "${data.dates}",
            "required": true
          },
          {
            "type": "EmbeddedLink",
            "text": "◀ Săptămâna trecută",
            "on-click-action": {
              "name": "data_exchange",
              "payload": { "nav": "prev", "week_offset": "${data.week_offset}" }
            }
          },
          {
            "type": "EmbeddedLink",
            "text": "Săptămâna următoare ▶",
            "on-click-action": {
              "name": "data_exchange",
              "payload": { "nav": "next", "week_offset": "${data.week_offset}" }
            }
          },
          {
            "type": "Footer",
            "label": "Continuă",
            "on-click-action": {
              "name": "data_exchange",
              "payload": { "date_id": "${form.date_id}" }
            }
          }
        ]
      }
    },
    {
      "id": "SLOT_SELECT",
      "title": "Alege ora",
      "data": {
        "slots": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "title": { "type": "string" }
            }
          },
          "__example__": [
            { "id": "2026-08-11_9", "title": "09:00 - 10:00" },
            { "id": "2026-08-11_10", "title": "10:00 - 11:00" }
          ]
        },
        "date_id": { "type": "string", "__example__": "2026-08-11" }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          { "type": "TextHeading", "text": "Ore disponibile" },
          {
            "type": "RadioButtonsGroup",
            "name": "slot_id",
            "label": "Interval orar",
            "data-source": "${data.slots}",
            "required": true
          },
          {
            "type": "Footer",
            "label": "Continuă",
            "on-click-action": {
              "name": "data_exchange",
              "payload": { "date_id": "${data.date_id}", "slot_id": "${form.slot_id}" }
            }
          }
        ]
      }
    },
    {
      "id": "FIELD_SELECT",
      "title": "Alege terenul",
      "data": {
        "fields": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "title": { "type": "string" }
            }
          },
          "__example__": [
            { "id": "2026-08-11_9_field1", "title": "Teren 1" },
            { "id": "2026-08-11_9_field2", "title": "Teren 2" }
          ]
        },
        "date_id": { "type": "string", "__example__": "2026-08-11" },
        "slot_id": { "type": "string", "__example__": "2026-08-11_9" }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          { "type": "TextHeading", "text": "Terenuri disponibile" },
          {
            "type": "RadioButtonsGroup",
            "name": "field_id",
            "label": "Teren",
            "data-source": "${data.fields}",
            "required": true
          },
          {
            "type": "Footer",
            "label": "Continuă",
            "on-click-action": {
              "name": "data_exchange",
              "payload": {
                "date_id": "${data.date_id}",
                "slot_id": "${data.slot_id}",
                "field_id": "${form.field_id}"
              }
            }
          }
        ]
      }
    },
    {
      "id": "CONFIRM",
      "title": "Confirmă rezervarea",
      "terminal": true,
      "data": {
        "summary": { "type": "string", "__example__": "Marți, 11 08 · 09:00 - 10:00 · Teren 1" },
        "date_id": { "type": "string", "__example__": "2026-08-11" },
        "slot_id": { "type": "string", "__example__": "2026-08-11_9" },
        "field_id": { "type": "string", "__example__": "2026-08-11_9_field1" }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          { "type": "TextHeading", "text": "Confirmă rezervarea" },
          { "type": "TextBody", "text": "${data.summary}" },
          { "type": "TextInput", "name": "name", "label": "Nume", "input-type": "text", "required": true },
          { "type": "TextInput", "name": "phone", "label": "Telefon", "input-type": "phone", "required": true },
          { "type": "TextArea", "name": "notes", "label": "Observații (opțional)", "required": false },
          {
            "type": "Footer",
            "label": "Confirmă rezervarea",
            "on-click-action": {
              "name": "complete",
              "payload": {
                "date_id": "${data.date_id}",
                "slot_id": "${data.slot_id}",
                "field_id": "${data.field_id}",
                "name": "${form.name}",
                "phone": "${form.phone}",
                "notes": "${form.notes}"
              }
            }
          }
        ]
      }
    }
  ]
}
